{
  "name": "saratoga-villa",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client & wait",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js",
    "test": "npm test -w server",
    "seed": "npm run seed -w server",
    "import:legacy": "npm run import:legacy -w server",
    "seed:demo": "npm run seed:demo -w server",
    "migrate:properties": "npm run migrate:properties -w server",
    "backfill:visitor-types": "npm run backfill:visitor-types -w server",
    "test:e2e": "npm run test:e2e -w server"
  }
}
